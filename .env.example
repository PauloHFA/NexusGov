# NexusGov - Variáveis de Ambiente de Exemplo
# Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusgov
DB_USER=nexus
DB_PASSWORD=nexus_dev_password

# Mensageria RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=nexus_rabbit_password

# Armazenamento Analítico MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nexusminio
MINIO_SECRET_KEY=nexus_minio_password
MINIO_BUCKET=nexusgov-parquet

# Escopo Piloto
PILOT_UF=PB
PILOT_IBGE_CODE=25
